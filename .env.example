# Variáveis do Docker (copie este arquivo para ".env" na raiz do repositório e preencha).
# O ".env" NUNCA vai para o Git. Dica: use senhas só com letras e números (evite $ % # " ' \ e espaços).
# Para rodar o backend FORA do Docker, continue usando o backend/.env (com DB_HOST=localhost).

# ---- Banco de dados (MySQL 8) ----
DB_NAME=sist_gest_est_mon
DB_USER=sistema
DB_PASSWORD=troque_esta_senha
MYSQL_ROOT_PASSWORD=troque_a_senha_do_root

# ---- Segurança da API ----
# Gere uma chave longa e aleatória, por exemplo:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque_por_uma_chave_longa_e_aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=8

# ---- Administrador inicial (criado só se o banco não tiver nenhum usuário; senha de 8 a 72 caracteres) ----
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@novasorvetes.com
ADMIN_SENHA=troque_esta_senha_admin

# ---- Dados da empresa nos PDFs ----
EMPRESA_NOME=Nova Sorvetes
EMPRESA_CNPJ=
EMPRESA_ENDERECO=
EMPRESA_TELEFONE=
EMPRESA_EMAIL=

# ---- Assistente de IA (opcional) ----
# Sem GEMINI_API_KEY o assistente fica desligado. O usuário MySQL somente leitura é criado sozinho.
IA_HABILITADO=false
GEMINI_API_KEY=
IA_MODELO=
IA_DB_USER=sistema_ia
IA_DB_PASSWORD=troque_a_senha_da_ia
IA_MODO_PRIVADO=false
IA_LIMITE_POR_HORA=20
IA_MAX_PASSOS=4
IA_MAX_LINHAS=200
IA_TIMEOUT_SEGUNDOS=5
IA_TIMEOUT_PROVEDOR=40
